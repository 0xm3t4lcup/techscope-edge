{
  "manifest_version": 3,
  "name": "TechScope",
  "version": "1.0.0",
  "description": "Profiles the technologies a website is built with — CMS, frameworks, analytics, servers, CDNs, and more.",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage",
    "webRequest",
    "tabs",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TechScope",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
